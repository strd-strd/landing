# Значения — только в .env.local (файл, не папка). Не коммитить.
# Публичные ссылки/телефон — lib/contacts.ts.
# Прод Beget: /var/www/investdemidov · PM2 investdemidov · :3005 · invest.demidovpark.ru

# Канонический URL сайта (sitemap, OG, абсолютные ссылки)
SITE_URL=https://invest.demidovpark.ru

# --- Telegram ---
# Токен бота (BotFather). Без него заявки и алерты ops не уйдут.
TOKEN_TELEGRAM=
# Группа/канал заявок инвесторов (опционально). Бот должен быть участником.
# «chat not found» = неверный id или бот не в чате.
LEAD_TELEGRAM_CHAT_ID=
# Менеджеры: получают заявки в личку (цифры, через запятую).
# Каждый должен нажать /start у бота. Не путать с ID_OPS.
ID_ADMIN=
# Разработчик / ops: алерты error/critical с сайта (и будущего бота).
# Сюда НЕ шлём заявки. Если пусто — fallback на первого из ID_ADMIN.
ID_OPS=

# --- Supabase (только сервер, service role) ---
# Можно тот же проект, что у demidovpark — таблицы с префиксом InvestDemidov_.
# SQL: supabase/investdemidov.sql (SQL Editor → Run).
# Без wizard Next.js / anon в клиенте.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
