# Значения — только в .env.local (файл, не папка). Не коммитить.
# Публичные ссылки/телефон — lib/contacts.ts.

# Прод Beget: /var/www/investdemidov · PM2 investdemidov · :3005 · invest.demidovpark.ru
SITE_URL=https://invest.demidovpark.ru

# Telegram: заявки с форм (/api/lead). Без token + хотя бы одного chat → 502.
TOKEN_TELEGRAM=
# Группа/канал заявок (опционально). Бот должен быть участником. «chat not found» = неверный id.
LEAD_TELEGRAM_CHAT_ID=
# Лички менеджеров (цифры, через запятую). Каждый должен нажать /start у бота.
ID_ADMIN=
# Алерты об ошибках. Если пусто — первый из ID_ADMIN
ID_OPS=
