# Значения — только в .env.local (файл, не папка). Не коммитить.
# Публичные ссылки/телефон — lib/contacts.ts.

# Прод Beget: /var/www/investdemidov · PM2 investdemidov · :3005 · invest.demidovpark.ru
SITE_URL=https://invest.demidovpark.ru

# Telegram: заявки с форм (/api/lead). Без пары token+chat → 502 на отправке.
TOKEN_TELEGRAM=
LEAD_TELEGRAM_CHAT_ID=
# Менеджеры (заявки), через запятую если несколько
ID_ADMIN=
# Алерты об ошибках (error/critical). Если пусто — первый из ID_ADMIN
ID_OPS=
